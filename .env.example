# Template only. Copy to .env and fill locally. .env is git-ignored and must never be committed.
# docs/02 §10 and docs/25 §5 require secrets isolation; G9 verifies it.

# ---- Environment ----
# One of: dev | test | staging | paper | shadow | live
# Live is deny-by-default and is NOT provisioned by this repository (docs/25 §3.7, WI-170 out of scope).
APP_ENV=dev

# ---- Local PostgreSQL 17 (system of record, docs/05) ----
# infra/compose.yaml brings this up. The three WEBTRADE_PG_* values are the bootstrap
# superuser and exist only to create the per-environment roles; the application never
# connects as them. The two WEBTRADE_*_PASSWORD values are the per-environment roles.
#
# Every one of these is required with no default, so `docker compose up` fails with a named
# message when one is missing rather than starting with a password that is in git history.
# Supply real local values. Nothing here is ever committed.
WEBTRADE_PG_SUPERUSER=web_trade_bootstrap
WEBTRADE_PG_SUPERUSER_PASSWORD=
WEBTRADE_PG_SUPERUSER_DB=postgres
WEBTRADE_PG_PORT=5432

# One role and one database per local environment, isolated by revoked CONNECT rather than by
# convention: web_trade_dev cannot reach web_trade_test, and neither can reach a paper, shadow,
# or live database, because those are not provisioned locally at all.
WEBTRADE_DEV_PASSWORD=
WEBTRADE_TEST_PASSWORD=

# Connection string the application uses locally. Database name selects the environment, which
# is why the isolation above is enforced by the server: a wrong name is refused, not silently
# accepted.
DATABASE_URL=postgres://web_trade_dev:@localhost:5432/web_trade_dev?sslmode=disable
TEST_DATABASE_URL=postgres://web_trade_test:@localhost:5432/web_trade_test?sslmode=disable

# ---- Redis 8 (cache only, never financial truth - ADR-007) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Identity (docs/21, ADR-017) ----
# OIDC Authorization Code + PKCE. SAML only at the federation boundary.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- Policy (ADR-018) ----
# Open Policy Agent evaluates identity/resource authorization.
# Policy cannot approve or override financial risk.
OPA_URL=

# ---- Observability (docs/08) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=web-trade-control-plane
